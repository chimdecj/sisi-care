# Gmail SMTP, matching the Steppe website's environment-setting names.
# Use a Google App Password, never your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Full sender address; leave blank to use SMTP_USER. Gmail aliases must be authorized.
SMTP_FROM=
# Recipient for care inquiries. If blank, uses contact.email in lib/content.ts.
CONTACT_TO=info@sisicarewa.com

# Exact live origin, e.g. https://your-domain.com (no trailing slash).
# Required in production. Localhost is allowed automatically in development.
SITE_ORIGIN=

# Google reCAPTCHA v2 checkbox keys for Sisi Care's domain and localhost.
# The public site key is read at BUILD time; rebuild after changing it.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Keep .env.local out of Git. All settings except the site key are server-only.
