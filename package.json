{
  "name": "sisi-care",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node server.js",
    "deploy:package": "node scripts/package-deployment.cjs",
    "test": "node --import tsx --conditions=react-server --test tests/*.test.ts",
    "admin:password": "node scripts/admin-password.cjs",
    "test:cms:live": "node tests/cms-live.cjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/lora": "^5.2.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "nodemailer": "^10.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-google-recaptcha": "^3.1.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-google-recaptcha": "^2.1.9",
    "prettier": "3.9.7",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
